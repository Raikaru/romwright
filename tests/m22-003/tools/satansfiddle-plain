#!/usr/bin/env python3
"""A plain stand-in for Satan's Fiddle (Dark Chronicle's MWCC state-controller), for lanes that cannot build it.

Same command line as `satansfiddle --config CONFIG --output OBJECT --translation-unit NAME SOURCE`; it reads the compiler
path and options out of CONFIG (as the repo's scripts/build/satansfiddle-wibo.py writes them) and runs the unmodified
pinned compiler under wibo. None of Fiddle's per-unit register-history or floating-point overrides are applied, so the
objects can differ from the repo's own build wherever those overrides matter. Written for m22-003; no repo code.
"""
import json
import shlex
import subprocess
import sys


def main(argv):
    config = output = source = None
    index = 0
    while index < len(argv):
        if argv[index] == "--config":
            config, index = argv[index + 1], index + 2
        elif argv[index] == "--output":
            output, index = argv[index + 1], index + 2
        elif argv[index] == "--translation-unit":
            index += 2
        else:
            source, index = argv[index], index + 1
    profile = json.load(open(config))
    command = ["wibo", profile["compiler_path"], *shlex.split(profile.get("compiler_options", "")), "-o", output, source]
    return subprocess.run(command).returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
