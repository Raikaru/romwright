+/// Parse one \<storedjump> element: the address of an indirect branch followed by one
+/// \<dest> per address the import stored for it. The table is the authority for that branch
+/// in every function whose flow reaches it (see JumpTable::recoverStored).
+/// \param decoder is the stream decoder
+void Architecture::decodeStoredJump(Decoder &decoder)
+
+{
+  uint4 elemId = decoder.openElement(ELEM_STOREDJUMP);
+  StoredJump stored;
+  stored.apply = decoder.readBool(ATTRIB_STOREDAPPLY);
+  Address branch = Address::decode(decoder);
+  while(decoder.peekElement() == ELEM_DEST) {
+    uint4 destId = decoder.openElement();
+    VarnodeData vData;
+    vData.decodeFromAttributes(decoder);
+    stored.targets.push_back(vData.getAddr());
+    decoder.closeElement(destId);
+  }
+  if (stored.targets.empty() || branch.isInvalid())
+    throw LowlevelError("Bad storedjump tag");
+  decoder.closeElement(elemId);
+  storedjumps[branch] = stored;
+}
+
+/// \param addr is the address of a BRANCHIND
+/// \return the table stored for it, or null
+const StoredJump *Architecture::queryStoredJump(const Address &addr) const
+
+{
+  map<Address,StoredJump>::const_iterator iter = storedjumps.find(addr);
+  if (iter == storedjumps.end()) return (const StoredJump *)0;
+  return &(*iter).second;
+}
+
