+/// A parameter assigned to a register of the floating-point class has the
+/// floating-point type, whatever integer type later propagation put on its
+/// bytes: the convention, not the use, says which register file a value is in.
+/// \param addr is the start of the storage range
+/// \param sz is the size of the range in bytes
+/// \return \b true if an input entry of the float storage class holds the whole range
+bool ProtoModel::inFloatRegister(const Address &addr,int4 sz) const
+
+{
+  const ParamListStandard *standard = dynamic_cast<const ParamListStandard *>(input);
+  if (standard == (const ParamListStandard *)0)
+    return false;
+  const list<ParamEntry> &entries(standard->getEntry());
+  for(list<ParamEntry>::const_iterator iter=entries.begin();iter!=entries.end();++iter) {
+    const ParamEntry &entry(*iter);
+    if (entry.getType() != TYPECLASS_FLOAT || entry.getSpace() != addr.getSpace()) continue;
+    if (addr.getOffset() >= entry.getBase() && addr.getOffset() + sz <= entry.getBase() + entry.getSize())
+      return true;
+  }
+  return false;
+}
