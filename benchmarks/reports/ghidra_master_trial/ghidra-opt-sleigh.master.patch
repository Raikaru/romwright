+/// \brief Find the normalized switch variable the way JumpBasic does, for a table supplied from outside (Romwright)
+///
+/// The guard analysis gives the normalized switch variable and the range of values it takes, exactly as
+/// it does when jumptable.cc recovers a table itself. Each value in the range is emulated to its address,
+/// and the model keeps the (value,address) pairs whose address is in the supplied set. This succeeds
+/// only if every supplied address is produced by some value in the range. Then the case values, the
+/// normalization to fold and the guards to fold are those of a recovered table, restricted to the
+/// supplied addresses, rather than values guessed upward from zero.
+/// \param fd is the function containing the switch
+/// \param indop is the BRANCHIND
+/// \param maxtablesize is the maximum size of the value range
+/// \return \b true if the model was recovered this way
+bool JumpBasicOverride::recoverFromGuards(Funcdata *fd,PcodeOp *indop,uint4 maxtablesize)
+
+{
+  if (jrange != (JumpValuesRange *)0)
+    delete jrange;
+  jrange = new JumpValuesRange();
+  varnodeIndex = 0;
+  bool ok = false;
+  try {
+    findNormalized(fd,indop->getParent(),-1,0,maxtablesize);
+    ok = (jrange->getSize() <= maxtablesize);
+  }
+  catch(LowlevelError &err) {
+    ok = false;
+  }
+  if (ok) {
+    markFoldableGuards();
+    vector<uintb> vals;
+    vector<Address> addrs;
+    set<Address> seen;
+    EmulateFunction emul(fd);
+    uintb mask = ~((uintb)0);
+    int4 bit = fd->getArch()->funcptr_align;
+    if (bit != 0)
+      mask = (mask >> bit) << bit;
+    AddrSpace *spc = indop->getAddr().getSpace();
+    try {
+      bool notdone = jrange->initializeForReading();
+      while(notdone) {
+	uintb val = jrange->getValue();
+	uintb addr = emul.emulatePath(val,pathMeld,jrange->getStartOp(),jrange->getStartVarnode());
+	addr = AddrSpace::addressToByte(addr,spc->getWordSize());
+	addr &= mask;
+	Address newaddr(spc,addr);
+	if (adset.find(newaddr) != adset.end()) {
+	  vals.push_back(val);
+	  addrs.push_back(newaddr);
+	  seen.insert(newaddr);
+	}
+	notdone = jrange->next();
+      }
+    }
+    catch(LowlevelError &err) {
+      ok = false;
+    }
+    if (ok && seen.size() == adset.size()) {
+      values = vals;
+      addrtable = addrs;
+      normalvn = pathMeld.getVarnode(varnodeIndex);
+      usedguards = true;
+      delete jrange;
+      jrange = (JumpValuesRange *)0;
+      return true;
+    }
+  }
+  selectguards.clear();
+  delete jrange;
+  jrange = (JumpValuesRange *)0;
+  return false;
 }
 
