+// Preserve the existing three-bit fields for collision sets of up to eight.
+// SIMD lane temporaries need larger sets: use previously unused bits for
+// four additional bits of position and total, keeping the formal hash intact.
+uint8 DynamicHash::withTotalPosition(uint8 h,uint4 position,uint4 total)
+{
+  if (total == 0 || total > 128 || position >= total)
+    throw LowlevelError("Invalid dynamic hash collision identity");
+  clearTotalPosition(h);
+  uint4 count = total - 1;
+  return h | ((uint8)(position&7)<<49) | ((uint8)(count&7)<<52)
+      | ((uint8)(position>>3)<<55) | ((uint8)(count>>3)<<59);
+}
