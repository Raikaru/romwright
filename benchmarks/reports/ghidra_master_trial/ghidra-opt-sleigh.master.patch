+/// \brief Test if an indirect jump turned into a RETURN took its target from the given storage
+///
+/// Romwright: a Thumb function can return with \b pop {r1}; bx r1, which the decompiler turns into a
+/// RETURN whose target is a general register that the output model also lists. That register holds
+/// the return address, not a result, so it must not be offered as a possible return value.
+/// \param fd is the function being analyzed
+/// \param addr is the first address of the storage
+/// \param size is the number of bytes in the storage
+/// \return \b true if a live RETURN reads its target from overlapping storage
+static bool romwrightReturnTargetOverlaps(Funcdata *fd,const Address &addr,int4 size)
+
+{
+  for(int4 i=0;i<fd->romwrightReturnTargets.size();++i) {
+    const VarnodeData &target(fd->romwrightReturnTargets[i]);
+    Address start(target.space,target.offset);
+    if (addr.overlap(0,start,target.size) != -1) return true;
+    if (start.overlap(0,addr,size) != -1) return true;
+  }
+  return false;
+}
