+/// \brief Recover the addresses of \b this table with the import's stored dispatch table as authority (Romwright)
+///
+/// jumptable.cc recovers the table first, exactly as it would without a stored table, so that its
+/// normalization, guards and case labels are available. Its address set is then compared with
+/// the stored one. If they are equal nothing else changes. If they differ (or jumptable.cc
+/// failed) and \b apply is set, the model is switched over to the manual override model
+/// (setOverride) carrying the stored addresses, which then rebuilds the case values by emulation,
+/// as it does for a table the user supplied. If \b apply is not set, the comparison is only
+/// recorded and jumptable.cc's outcome stands, failure included.
+/// \param fd is the (partial) function containing the switch
+/// \param stored is the stored table
+/// \param apply is \b true to install the stored table over a differing recovery
+void JumpTable::recoverStored(Funcdata *fd,const vector<Address> &stored,bool apply)
+
+{
+  set<Address> want(stored.begin(),stored.end());
+  bool failed = false;
+  bool thunk = false;
+  string why;
+  try {
+    if (isPartial())
+      recoverMultistage(fd);
+    else
+      recoverAddresses(fd);
+  }
+  catch(JumptableThunkError &err) {
+    failed = thunk = true;
+    why = err.explain;
+  }
+  catch(LowlevelError &err) {
+    failed = true;
+    why = err.explain;
+  }
+  storedSize = want.size();
+  stockSize = -1;
+  commonSize = 0;
+  bool same = false;
+  if (!failed) {
+    set<Address> got(addresstable.begin(),addresstable.end());
+    stockSize = got.size();
+    for(set<Address>::const_iterator iter=got.begin();iter!=got.end();++iter)
+      if (want.find(*iter) != want.end())
+	commonSize += 1;
+    same = (stockSize == storedSize && commonSize == stockSize);
+  }
+  if (same) {
+    storedState = stored_confirmed;
+    return;
+  }
+  if (!apply) {
+    storedState = stored_observed;
+    if (thunk)
+      throw JumptableThunkError(why);
+    if (failed)
+      throw LowlevelError(why);
+    return;
+  }
+  // Try the stored table as a manual override over jumptable.cc's own model. If that finds no
+  // normalized switch variable (the trivial model labels cases with addresses, which would
+  // not match what is switched on), the override is not used and jumptable.cc's outcome stands.
+  JumpModel *stockmodel = jmodel;
+  jmodel = (JumpModel *)0;
+  vector<Address> stocktable = addresstable;
+  vector<LoadTable> stockloads = loadpoints;
+  bool stockpartial = partialTable;
+  setOverride(stored,Address(),0,0);
+  addresstable.clear();
+  loadpoints.clear();
+  label.clear();
+  partialTable = false;
+  bool installed = false;
+  try {
+    recoverAddresses(fd);
+    installed = (jmodel != (JumpModel *)0) && !((JumpBasicOverride *)jmodel)->isTrivialModel();
+  }
+  catch(LowlevelError &err) {
+    installed = false;
+  }
+  if (installed) {
+    storedState = stored_applied;
+    if (stockmodel != (JumpModel *)0)
+      delete stockmodel;
+    return;
+  }
+  if (jmodel != (JumpModel *)0)
+    delete jmodel;
+  jmodel = stockmodel;
+  addresstable = stocktable;
+  loadpoints = stockloads;
+  partialTable = stockpartial;
+  label.clear();
+  storedState = stored_observed;
+  if (thunk)
+    throw JumptableThunkError(why);
+  if (failed)
+    throw LowlevelError(why);
+}
