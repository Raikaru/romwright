dest: ".xyz"  is vudest=0b1110 { export 0b1110:4; }
dest: ".xyzw" is vudest=0b1111 { export 0b1111:4; }

bc: "x" is vubc=0 { export 96:7; }
bc: "y" is vubc=1 { export 64:7; }
bc: "z" is vubc=2 { export 32:7; }
bc: "w" is vubc=3 { export 0:7; }

fsf: "x"     is vufsf=0 { export 0:1; }
fsf: "y"     is vufsf=1 { export 0:1; }
fsf: "z"     is vufsf=2 { export 0:1; }
fsf: "w"     is vufsf=3 { export 0:1; }

ftf: "x"     is vuftf=0 { export 0:1; }
ftf: "y"     is vuftf=1 { export 0:1; }
ftf: "z"     is vuftf=2 { export 0:1; }
ftf: "w"     is vuftf=3 { export 0:1; }

:vabs^dest vuft, vufs                             is vuinst & dest      & vuft & vufs        & vuop_0_10=0b00111111101
        {
      local res:16 = vuft;
      local pw:4 = vufs[0,32]  & 0x7fffffff;
      local pz:4 = vufs[32,32] & 0x7fffffff;
      local py:4 = vufs[64,32] & 0x7fffffff;
      local px:4 = vufs[96,32] & 0x7fffffff;
      local mw:4 = 0:4 - zext(dest & 1);
      local mz:4 = 0:4 - zext((dest >> 1) & 1);
      local my:4 = 0:4 - zext((dest >> 2) & 1);
      local mx:4 = 0:4 - zext((dest >> 3) & 1);
      res[0,32]  = (pw & mw) | (res[0,32]  & ~mw);
      res[32,32] = (pz & mz) | (res[32,32] & ~mz);
      res[64,32] = (py & my) | (res[64,32] & ~my);
      res[96,32] = (px & mx) | (res[96,32] & ~mx);
      vuft = res;
    }
