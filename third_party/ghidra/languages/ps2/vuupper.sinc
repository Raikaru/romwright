I: ""   is vuinterlock=0 { export 0:1; }
I: ".I" is vuinterlock=1 { export 0:1; }

dest: ""      is vudest=0b0000 { export 0b0000:4; }
dest: ".w"    is vudest=0b0001 { export 0b0001:4; }
dest: ".z"    is vudest=0b0010 { export 0b0010:4; }
dest: ".zw"   is vudest=0b0011 { export 0b0011:4; }
dest: ".y"    is vudest=0b0100 { export 0b0100:4; }
dest: ".yw"   is vudest=0b0101 { export 0b0101:4; }
dest: ".yz"   is vudest=0b0110 { export 0b0110:4; }
dest: ".yzw"  is vudest=0b0111 { export 0b0111:4; }
dest: ".x"    is vudest=0b1000 { export 0b1000:4; }
dest: ".xw"   is vudest=0b1001 { export 0b1001:4; }
dest: ".xz"   is vudest=0b1010 { export 0b1010:4; }
dest: ".xzw"  is vudest=0b1011 { export 0b1011:4; }
