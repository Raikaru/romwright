+/// A context value written after an instruction was parsed invalidates two
+/// caches: ContextCache keeps a pointer into the database's own context blob
+/// (globalcontext.hh:317-331), which a set may move, and every ParserContext
+/// in the DisassemblyCache was resolved under the value that just changed.
+/// Rebuild both, exactly as initialize() sizes them.
+void Sleigh::invalidateContextCache(void)
+{
+  delete discache;
+  discache = (DisassemblyCache *)0;
+  delete cache;
+  cache = new ContextCache(context_db);
+  uint4 parser_cachesize = 2;
+  uint4 parser_windowsize = 32;
+  if ((maxdelayslotbytes > 1)||(unique_allocatemask != 0)) {
+    parser_cachesize = 8;
+    parser_windowsize = 256;
+  }
+  discache = new DisassemblyCache(this,cache,getConstantSpace(),parser_cachesize,parser_windowsize);
+  pcode_cache.clear();
+}
