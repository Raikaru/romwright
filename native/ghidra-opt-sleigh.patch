+
+void SetFunctionSignature::rawAction(void)
+
+{
+  if (mode != "asserted" && mode != "inferred" && mode != "recovery" && mode != "params")
+    throw ParseError("Unknown prototype mode: " + mode);
+  istringstream input(signature);
+  PrototypePieces pieces;
+  parse_protopieces(pieces,input,ghidra);
+  string requestedName = pieces.name;
+  if (functionName.empty())
+    functionName = requestedName;
+  if (functionName.empty())
+    throw ParseError("Prototype has no function name");
+  if (requestedName.empty()) {
+    requestedName = functionName;
+    pieces.name = functionName;
+  }
+  istringstream addressInput(functionAddress);
+  uintb offset = 0;
+  addressInput >> hex >> offset;
+  if (addressInput.fail())
+    throw ParseError("Bad function address: " + functionAddress);
+  Address functionAddressValue(ghidra->getDefaultCodeSpace(),offset);
+  Funcdata *fd = ghidra->symboltab->getGlobalScope()->findFunction(functionAddressValue);
+  if (fd == (Funcdata *)0)
+    throw ParseError("Unknown function address: " + functionAddress);
+  fd->getFuncProto().setPieces(pieces);
+  if (mode == "recovery") {
+    fd->getFuncProto().setInputLock(false);
+    fd->getFuncProto().setOutputLock(false);
+    fd->getFuncProto().setModelLock(false);
+  }
+  if (mode == "params") {
+    // The parameter list is proved (a mangled name's); the return value is
+    // not, so the decompiler recovers it.
+    fd->getFuncProto().setOutputLock(false);
+  }
+  if (mode == "asserted" && requestedName != functionName) {
+    ScopeGhidra *ghidraScope = dynamic_cast<ScopeGhidra *>(ghidra->symboltab->getGlobalScope());
+    if (ghidraScope == (ScopeGhidra *)0)
+      throw LowlevelError("Global scope is not Ghidra-backed");
+    ghidraScope->renameFunction(fd->getSymbol(),requestedName);
+  }
+  ghidra->clearAnalysis(fd);
+}
