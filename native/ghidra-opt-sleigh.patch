+/// \class IfcContext
+/// \brief Set a context register value: `context <name> <address> <value>`
+///
+/// The value applies from \e address onward, which is how a processor's own
+/// mode register is carried into disassembly (ContextDatabase::setVariable).
+void IfcContext::execute(istream &s)
+
+{
+  if (dcp->conf == (Architecture *)0)
+    throw IfaceExecutionError("No architecture loaded");
+  string name;
+  s >> ws >> name;
+  if (name.empty())
+    throw IfaceExecutionError("Missing context register name");
+  int4 size;
+  Address addr = parse_machaddr(s,size,*dcp->conf->types);
+  if (addr.isInvalid())
+    throw IfaceExecutionError("Missing context address");
+  uintb value;
+  s >> ws;
+  s.unsetf(ios::dec | ios::hex | ios::oct);
+  if (!(s >> value))
+    throw IfaceExecutionError("Missing context value");
+  dcp->conf->context->setVariable(name,addr,(uintm)value);
+  if (const Sleigh *sleigh = dynamic_cast<const Sleigh *>(dcp->conf->translate))
+    const_cast<Sleigh *>(sleigh)->invalidateContextCache();
+  *status->fileoptr << "CONTEXT " << name << ' ' << addr.getShortcut() << "0x" << hex
+                    << addr.getOffset() << " = " << dec << value << '\n';
+  status->fileoptr->flush();
+}
