+void IfcFlow::execute(istream &s)
+
+{
+  if (dcp->conf == (Architecture *)0)
+    throw IfaceExecutionError("No architecture loaded");
+
+  Address addr;
+  int4 size;
+  addr = parse_machaddr(s,size,*dcp->conf->types);
+
+  class FlowPcodeEmit : public PcodeEmit {
+  public:
+    struct Op {
+      OpCode opc;
+      Address target;
+      bool has_target;
+      Op(void) : opc(CPUI_COPY), has_target(false) {}
+    };
+    vector<Op> ops;
+    virtual void dump(const Address &a,OpCode opc,VarnodeData *outvar,VarnodeData *vars,int4 isize) {
+      Op op;
+      op.opc = opc;
+      op.has_target = false;
+      if (isize > 0 && vars[0].space != (AddrSpace *)0) {
+        if (vars[0].space->getType() == IPTR_CONSTANT) {
+          op.target = Address(a.getSpace(),vars[0].offset);
+          op.has_target = true;
+        } else if (vars[0].space->getType() == IPTR_PROCESSOR) {
+          op.target = Address(vars[0].space,vars[0].offset);
+          op.has_target = true;
+        }
+      }
+      ops.push_back(op);
+    }
+  };
+
+  FlowPcodeEmit emitter;
+  int4 length = 0;
+  try {
+    length = dcp->conf->translate->oneInstruction(emitter,addr);
+  } catch(BadDataError &err) {
+    *status->fileoptr << "FLOW " << addr.getShortcut() << "0x" << hex << addr.getOffset() << " len=1 fall=none kind=BAD targets=" << endl;
+    return;
+  } catch(UnimplError &err) {
+    *status->fileoptr << "FLOW " << addr.getShortcut() << "0x" << hex << addr.getOffset() << " len=1 fall=none kind=UNIMPL targets=" << endl;
+    return;
+  }
+
+  string kind = "FALLTHROUGH";
+  bool has_fallthrough = true;
+  vector<Address> targets;
+
+  for(size_t i=0;i<emitter.ops.size();++i) {
+    OpCode opc = emitter.ops[i].opc;
+    switch(opc) {
+      case CPUI_BRANCH:
+        kind = "BRANCH";
+        has_fallthrough = false;
+        if (emitter.ops[i].has_target) targets.push_back(emitter.ops[i].target);
+        break;
+      case CPUI_CBRANCH:
+        kind = "CBRANCH";
+        has_fallthrough = true;
+        if (emitter.ops[i].has_target) targets.push_back(emitter.ops[i].target);
+        break;
+      case CPUI_BRANCHIND:
+        kind = "BRANCHIND";
+        has_fallthrough = false;
+        break;
+      case CPUI_CALL:
+        kind = "CALL";
+        has_fallthrough = true;
+        if (emitter.ops[i].has_target) targets.push_back(emitter.ops[i].target);
+        break;
+      case CPUI_CALLIND:
+        kind = "CALLIND";
+        has_fallthrough = true;
+        break;
+      case CPUI_RETURN:
+        kind = "RETURN";
+        has_fallthrough = false;
+        break;
+      default:
+        break;
+    }
+  }
+
+  *status->fileoptr << "FLOW " << addr.getShortcut() << "0x" << hex << addr.getOffset() << " len=" << dec << length;
+  if (has_fallthrough) {
+    Address fall = addr + length;
+    *status->fileoptr << " fall=" << fall.getShortcut() << "0x" << hex << fall.getOffset();
+  } else {
+    *status->fileoptr << " fall=none";
+  }
+  *status->fileoptr << " kind=" << kind << " targets=";
+  for(size_t i=0;i<targets.size();++i) {
+    if (i > 0) *status->fileoptr << ",";
+    *status->fileoptr << targets[i].getShortcut() << "0x" << hex << targets[i].getOffset();
+  }
+  *status->fileoptr << endl;
+}
