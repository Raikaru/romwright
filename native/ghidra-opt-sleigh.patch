+  if (walker.depth == ParserWalker::MAX_PARSE_DEPTH)
+    throw LowlevelError("Exceeded maximum parse depth");
+  // Each state's operand array is sized at 20 (initialize(75,20), sleigh.cc:457),
+  // but a constructor may name more: PowerPC lmw/stmw name every register from
+  // rD to r31 (27 operands for r5). Indexing past the end overwrote the heap
+  // neighbour's allocator header, and the decompiler died on a later free.
