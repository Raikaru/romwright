+/// The facts ScopeLocal::buildVariableName reads before it builds a stack variable name.
+/// \param addr is the storage address
+/// \param flags are the Varnode flags
+/// \param start passes back the signed offset printed in the name
+/// \param unusual passes back true if the name has the \e Y form (unusual stack region)
+/// \return true if the stack form applies
+bool ScopeLocal::romwrightStackNaming(const Address &addr,uint4 flags,int8 &start,bool &unusual) const
+
+{
+  unusual = false;
+  if (((flags & (Varnode::addrtied|Varnode::persist))==Varnode::addrtied) && addr.getSpace() == space) {
+    if (fd->getFuncProto().getLocalRange().inRange(addr,1)) {
+      intb off = (intb) AddrSpace::byteToAddress(addr.getOffset(),space->getWordSize());
+      off = sign_extend(off,addr.getAddrSize()*8-1);
+      if (stackGrowsNegative)
+	off = -off;
+      if (off > 0 && (minParamOffset < maxParamOffset) &&
+	  (stackGrowsNegative ? (addr.getOffset() < minParamOffset) : (addr.getOffset() > maxParamOffset)))
+	unusual = true;
+      start = off;
+      return true;
+    }
+  }
+  return false;
+}
