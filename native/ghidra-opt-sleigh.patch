+void IfcFlow::execute(istream &s)
+
+{
+  if (dcp->conf == (Architecture *)0)
+    throw IfaceExecutionError("No architecture loaded");
+
+  const Sleigh *sleigh = dynamic_cast<const Sleigh *>(dcp->conf->translate);
+  if (sleigh == nullptr)
+    throw IfaceExecutionError("Flow requires a SLEIGH translator");
+  class FlowPcodeEmit : public PcodeEmit {
+  public:
+    int4 count = 0;
+    bool firstBranch = false;
+    bool returnOp = false;
+    virtual void dump(const Address &a,OpCode opc,VarnodeData *outvar,VarnodeData *vars,int4 isize) {
+      if (count++ == 0)
+        firstBranch = opc == CPUI_BRANCH && isize > 0
+          && vars[0].space->getType() == IPTR_PROCESSOR;
+      returnOp |= opc == CPUI_RETURN;
+    }
+  };
+  InstructionFlow flow;
+
+  while (true) {
+    s >> ws;
+    if (s.eof() || s.peek() == -1) break;
+    Address addr;
+    int4 size;
+    try {
+      addr = parse_machaddr(s,size,*dcp->conf->types);
+    } catch(...) {
+      break;
+    }
+    if (addr.isInvalid()) break;
+
+    FlowPcodeEmit emitter;
+    int4 length = 0;
+    try {
+      length = sleigh->oneInstructionFlow(emitter,addr,flow);
+    } catch(BadDataError &err) {
+      *status->fileoptr << "FLOW " << addr.getShortcut() << "0x" << hex << addr.getOffset() << " len=1 fall=none kind=BAD terminal=0 conditional=0 return_op=0 delays= targets=" << '\n';
+      continue;
+    } catch(UnimplError &err) {
+      *status->fileoptr << "FLOW " << addr.getShortcut() << "0x" << hex << addr.getOffset() << " len=1 fall=none kind=UNIMPL terminal=0 conditional=0 return_op=0 delays= targets=" << '\n';
+      continue;
+    } catch(LowlevelError &err) {
+      *status->fileoptr << "FLOW " << addr.getShortcut() << "0x" << hex << addr.getOffset() << " len=1 fall=none kind=BAD terminal=0 conditional=0 return_op=0 delays= targets=" << '\n';
+      continue;
+    }
+
+    InstructionFlow::Type type = flow.type();
+
+    *status->fileoptr << "FLOW " << addr.getShortcut() << "0x" << hex << addr.getOffset() << " len=" << dec << length;
+    if (type.fallthrough) {
+      Address fall = addr + length;
+      *status->fileoptr << " fall=" << fall.getShortcut() << "0x" << hex << fall.getOffset();
+    } else {
+      *status->fileoptr << " fall=none";
+    }
+    *status->fileoptr << " pure_jump=" << (emitter.count == 1 && emitter.firstBranch ? 1 : 0);
+    *status->fileoptr << " no_op=" << (emitter.count == 0 ? 1 : 0);
+    *status->fileoptr << " terminal=" << (type.terminal ? 1 : 0) << " conditional=" << (type.conditional ? 1 : 0);
+    *status->fileoptr << " return_op=" << (emitter.returnOp ? 1 : 0) << " delays=";
+    for(size_t i=0;i<flow.delaySlots.size();++i) {
+      if (i > 0) *status->fileoptr << ",";
+      *status->fileoptr << dec << flow.delaySlots[i];
+    }
+    *status->fileoptr << " kind=" << type.kind << " targets=";
+    for(size_t i=0;i<flow.targets.size();++i) {
+      if (i > 0) *status->fileoptr << ",";
+      *status->fileoptr << flow.targets[i].getShortcut() << "0x" << hex << flow.targets[i].getOffset();
+    }
+    // The instruction set this address was decoded in, on a language that
+    // carries one in a context field named as Ghidra names it. A caller
+    // records it, so a later console decodes the same bytes the same way.
+    // Ghidra's disassembler also carries that value along flow to every
+    // branch and call target (DisassemblerContextImpl); this database only
+    // holds explicit change points, so name what flows to each target: a
+    // globalset at the target (an ARM blx, ARMinstructions.sinc:773) wins
+    // and is named so a sibling console learns it, otherwise the value
+    // flows unchanged and is named only where the held value differs.
+    try {
+      ContextDatabase *contextdb = dcp->conf->context;
+      uintm mode = contextdb->getVariable("LowBitCodeMode", addr);
+      *status->fileoptr << " mode=" << dec << mode;
+      *status->fileoptr << " flow_modes=";
+      bool firstMode = true;
+      for(size_t i=0;i<flow.targets.size();++i) {
+        const Address &target(flow.targets[i]);
+        if (target.getSpace() != addr.getSpace()) continue;
+        uintb first,last;
+        contextdb->getContext(target,first,last);
+        uintm held = contextdb->getVariable("LowBitCodeMode", target);
+        bool changePoint = first == target.getOffset();
+        if (!changePoint && held == mode) continue;
+        if (!firstMode) *status->fileoptr << ",";
+        firstMode = false;
+        *status->fileoptr << target.getShortcut() << "0x" << hex << target.getOffset() << ":" << dec << (changePoint ? held : mode);
+      }
+    } catch(LowlevelError &err) {
+    }
+    *status->fileoptr << '\n';
+  }
+  status->fileoptr->flush();
+}
