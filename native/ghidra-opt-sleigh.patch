 Translate *ArchitectureGhidra::buildTranslator(DocumentStorage &store)
 
 {
+  const char *slafile = getenv("VENTRIS_SLA");
+  if ((slafile != (const char *)0) && (slafile[0] != '\0')) {
+    // Raw-SLEIGH mode (spike): register the <sleigh> tag whose CONTENT is
+    // the compiled .sla path (same handshake as
+    // SleighArchitecture::buildSpecFile, sleigh_arch.cc:410-418), then
+    // build a self-disassembling Sleigh translator instead of the
+    // client-driven GhidraTranslate. The slave instruction bytes come from
+    // the client via getBytes (LoadImageGhidra), so the worker's
+    // program-provider serves both bytes and pcode generation.
+    // The client's tspec names the truncations its language declares
+    // (mips.ldefs: <truncate_space space="ram" size="4"/> on 64-32addr);
+    // GhidraTranslate::decode applied them in client-driven mode. Keep them
+    // before the tag is replaced, and apply them from modifySpaces as
+    // SleighArchitecture does (sleigh_arch.cc:423-429). Without this the
+    // stack pointer stays 8 bytes wide in a 4-byte space
+    // (Architecture::decodeStackPointer) and no sp-relative access is a
+    // stack address.
+    rawTruncations.clear();
+    const Element *tspecRoot = store.getTag("sleigh");
+    if (tspecRoot != (const Element *)0) {
+      const List &children(tspecRoot->getChildren());
+      for(List::const_iterator iter=children.begin();iter!=children.end();++iter) {
+        if ((*iter)->getName() != ELEM_TRUNCATE_SPACE.getName()) continue;
+        XmlDecode decoder(this,*iter);
+        rawTruncations.emplace_back();
+        rawTruncations.back().decode(decoder);
+      }
+    }
+    istringstream s(string("<sleigh>") + slafile + "</sleigh>");
+    Document *doc = store.parseDocument(s);
+    store.registerTag(doc->getRoot());
+    Sleigh *trans = new Sleigh(loader, context);
+    return trans;
+  }
   return new GhidraTranslate(this);
 }
 
