# ---- 3-operand ALU/logical (opcode = XOP4 + VMXB4) ----
:vaddfp128 vmxD,vmxA,vmxB	is OP=5 & vmxD & vmxA & vmxB & XOP4=0 & VMXB4=1 { vaddfp128Op(vmxD,vmxA,vmxB); }
:vsubfp128 vmxD,vmxA,vmxB	is OP=5 & vmxD & vmxA & vmxB & XOP4=1 & VMXB4=1 { vsubfp128Op(vmxD,vmxA,vmxB); }
:vmulfp128 vmxD,vmxA,vmxB	is OP=5 & vmxD & vmxA & vmxB & XOP4=2 & VMXB4=1 { vmulfp128Op(vmxD,vmxA,vmxB); }
:vmaddfp128 vmxD,vmxA,vmxB	is OP=5 & vmxD & vmxA & vmxB & XOP4=3 & VMXB4=1 { vmaddfp128Op(vmxD,vmxA,vmxB); }
:vmaddcfp128 vmxD,vmxA,vmxB	is OP=5 & vmxD & vmxA & vmxB & XOP4=4 & VMXB4=1 { vmaddcfp128Op(vmxD,vmxA,vmxB); }
:vnmsubfp128 vmxD,vmxA,vmxB	is OP=5 & vmxD & vmxA & vmxB & XOP4=5 & VMXB4=1 { vnmsubfp128Op(vmxD,vmxA,vmxB); }
:vmsum3fp128 vmxD,vmxA,vmxB	is OP=5 & vmxD & vmxA & vmxB & XOP4=6 & VMXB4=1 { vmsum3fp128Op(vmxD,vmxA,vmxB); }
:vmsum4fp128 vmxD,vmxA,vmxB	is OP=5 & vmxD & vmxA & vmxB & XOP4=7 & VMXB4=1 { vmsum4fp128Op(vmxD,vmxA,vmxB); }
:vand128 vmxD,vmxA,vmxB	is OP=5 & vmxD & vmxA & vmxB & XOP4=8 & VMXB4=1 { vand128Op(vmxD,vmxA,vmxB); }
