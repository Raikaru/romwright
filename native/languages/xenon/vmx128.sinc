# VMX128 — Xbox 360 Xenon 128-register vector extension.
# Encoding per Biallas vmx128.txt rev 1.2 + xenia ppc_opcode_table_gen.cc.
# Register operands are split fields; the high bits live inside the low-11
# opcode region, so each operand is a sub-table over 4 display/variable
# field pairs (one per 32-reg bank).

define register offset=0x5000 size=16 [
  vmx0 vmx1 vmx2 vmx3 vmx4 vmx5 vmx6 vmx7 vmx8 vmx9 vmx10 vmx11 vmx12 vmx13 vmx14 vmx15 vmx16 vmx17 vmx18 vmx19 vmx20 vmx21 vmx22 vmx23 vmx24 vmx25 vmx26 vmx27 vmx28 vmx29 vmx30 vmx31 vmx32 vmx33 vmx34 vmx35 vmx36 vmx37 vmx38 vmx39 vmx40 vmx41 vmx42 vmx43 vmx44 vmx45 vmx46 vmx47 vmx48 vmx49 vmx50 vmx51 vmx52 vmx53 vmx54 vmx55 vmx56 vmx57 vmx58 vmx59 vmx60 vmx61 vmx62 vmx63
];
define register offset=0x5400 size=16 [
  vmx64 vmx65 vmx66 vmx67 vmx68 vmx69 vmx70 vmx71 vmx72 vmx73 vmx74 vmx75 vmx76 vmx77 vmx78 vmx79 vmx80 vmx81 vmx82 vmx83 vmx84 vmx85 vmx86 vmx87 vmx88 vmx89 vmx90 vmx91 vmx92 vmx93 vmx94 vmx95 vmx96 vmx97 vmx98 vmx99 vmx100 vmx101 vmx102 vmx103 vmx104 vmx105 vmx106 vmx107 vmx108 vmx109 vmx110 vmx111 vmx112 vmx113 vmx114 vmx115 vmx116 vmx117 vmx118 vmx119 vmx120 vmx121 vmx122 vmx123 vmx124 vmx125 vmx126 vmx127
];

