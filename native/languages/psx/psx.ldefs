<?xml version="1.0" encoding="UTF-8"?>

<language_definitions>
  <language processor="PSX"
            endian="little"
            size="32"
            variant="default"
            version="2.0"
            slafile="psx.sla"
            processorspec="psx.pspec"
            id="PSX:LE:32:default">
    <description>Sony PlayStation R3000A with GTE (COP2), 32-bit addresses, little endian</description>
    <compiler name="default" spec="psx.cspec" id="default"/>
    <external_name tool="gnu" name="mips:3000"/>
    <external_name tool="IDA-PRO" name="mipsl"/>
  </language>
</language_definitions>
