# Lane tables for the VU0 macro instructions (generated by gen_vu.py; do not edit).
#
# Each table exports one lane as a 4-byte varnode. A destination table exports the
# register lane when the dest mask keeps it and the register is not vf0, otherwise a
# dead unique, so every constructor writes all four lanes and the decompiler deletes the
# masked ones. A source table exports vf0 as the constant (0, 0, 0, 1.0).
# Source: S (fs), T (ft). Destination: D (fd, masked), E (ft, masked), W (ft, unmasked),
# V (fs, unmasked), A (ACC, masked).

define pcodeop _cfc2;

Sx: vfs_x  is vufs != 0 & vfs_x { export vfs_x; }
Sx:         is vufs = 0 { export 0:4; }
Sy: vfs_y  is vufs != 0 & vfs_y { export vfs_y; }
Sy:         is vufs = 0 { export 0:4; }
Sz: vfs_z  is vufs != 0 & vfs_z { export vfs_z; }
Sz:         is vufs = 0 { export 0:4; }
Sw: vfs_w  is vufs != 0 & vfs_w { export vfs_w; }
Sw:         is vufs = 0 { export 0x3f800000:4; }
Tx: vft_x  is vuft != 0 & vft_x { export vft_x; }
Tx:         is vuft = 0 { export 0:4; }
Ty: vft_y  is vuft != 0 & vft_y { export vft_y; }
Ty:         is vuft = 0 { export 0:4; }
Tz: vft_z  is vuft != 0 & vft_z { export vft_z; }
Tz:         is vuft = 0 { export 0:4; }
Tw: vft_w  is vuft != 0 & vft_w { export vft_w; }
Tw:         is vuft = 0 { export 0x3f800000:4; }
Dx: vfd_x  is vmx = 1 & vufd != 0 & vfd_x { export vfd_x; }
Dx:         is vmx = 1 & vufd = 0 { local t:4; export t; }
Dx:         is vmx = 0 { local t:4; export t; }
Dy: vfd_y  is vmy = 1 & vufd != 0 & vfd_y { export vfd_y; }
Dy:         is vmy = 1 & vufd = 0 { local t:4; export t; }
Dy:         is vmy = 0 { local t:4; export t; }
Dz: vfd_z  is vmz = 1 & vufd != 0 & vfd_z { export vfd_z; }
Dz:         is vmz = 1 & vufd = 0 { local t:4; export t; }
Dz:         is vmz = 0 { local t:4; export t; }
Dw: vfd_w  is vmw = 1 & vufd != 0 & vfd_w { export vfd_w; }
Dw:         is vmw = 1 & vufd = 0 { local t:4; export t; }
Dw:         is vmw = 0 { local t:4; export t; }
Ex: vft_x  is vmx = 1 & vuft != 0 & vft_x { export vft_x; }
Ex:         is vmx = 1 & vuft = 0 { local t:4; export t; }
Ex:         is vmx = 0 { local t:4; export t; }
Ey: vft_y  is vmy = 1 & vuft != 0 & vft_y { export vft_y; }
Ey:         is vmy = 1 & vuft = 0 { local t:4; export t; }
Ey:         is vmy = 0 { local t:4; export t; }
Ez: vft_z  is vmz = 1 & vuft != 0 & vft_z { export vft_z; }
Ez:         is vmz = 1 & vuft = 0 { local t:4; export t; }
Ez:         is vmz = 0 { local t:4; export t; }
Ew: vft_w  is vmw = 1 & vuft != 0 & vft_w { export vft_w; }
Ew:         is vmw = 1 & vuft = 0 { local t:4; export t; }
Ew:         is vmw = 0 { local t:4; export t; }
Wx: vft_x  is vuft != 0 & vft_x { export vft_x; }
Wx:         is vuft = 0 { local t:4; export t; }
Wy: vft_y  is vuft != 0 & vft_y { export vft_y; }
Wy:         is vuft = 0 { local t:4; export t; }
Wz: vft_z  is vuft != 0 & vft_z { export vft_z; }
Wz:         is vuft = 0 { local t:4; export t; }
Ww: vft_w  is vuft != 0 & vft_w { export vft_w; }
Ww:         is vuft = 0 { local t:4; export t; }
Vx: vfs_x  is vufs != 0 & vfs_x { export vfs_x; }
Vx:         is vufs = 0 { local t:4; export t; }
Vy: vfs_y  is vufs != 0 & vfs_y { export vfs_y; }
Vy:         is vufs = 0 { local t:4; export t; }
Vz: vfs_z  is vufs != 0 & vfs_z { export vfs_z; }
Vz:         is vufs = 0 { local t:4; export t; }
Vw: vfs_w  is vufs != 0 & vfs_w { export vfs_w; }
Vw:         is vufs = 0 { local t:4; export t; }
Ax:         is vmx = 1 { export vuACCx; }
Ax:         is vmx = 0 { local t:4; export t; }
Ay:         is vmy = 1 { export vuACCy; }
Ay:         is vmy = 0 { local t:4; export t; }
Az:         is vmz = 1 { export vuACCz; }
Az:         is vmz = 0 { local t:4; export t; }
Aw:         is vmw = 1 { export vuACCw; }
Aw:         is vmw = 0 { local t:4; export t; }

# Broadcast ft lane (bc field, bits 0-1), and the fsf / ftf selected scalar lanes.
Bv: vft_x  is vubc = 0 & vuft != 0 & vft_x { export vft_x; }
Bv:         is vubc = 0 & vuft = 0 { export 0:4; }
Bv: vft_y  is vubc = 1 & vuft != 0 & vft_y { export vft_y; }
Bv:         is vubc = 1 & vuft = 0 { export 0:4; }
Bv: vft_z  is vubc = 2 & vuft != 0 & vft_z { export vft_z; }
Bv:         is vubc = 2 & vuft = 0 { export 0:4; }
Bv: vft_w  is vubc = 3 & vuft != 0 & vft_w { export vft_w; }
Bv:         is vubc = 3 & vuft = 0 { export 0x3f800000:4; }
Fsv: vfs_x  is vufsf = 0 & vufs != 0 & vfs_x { export vfs_x; }
Fsv:         is vufsf = 0 & vufs = 0 { export 0:4; }
Fsv: vfs_y  is vufsf = 1 & vufs != 0 & vfs_y { export vfs_y; }
Fsv:         is vufsf = 1 & vufs = 0 { export 0:4; }
Fsv: vfs_z  is vufsf = 2 & vufs != 0 & vfs_z { export vfs_z; }
Fsv:         is vufsf = 2 & vufs = 0 { export 0:4; }
Fsv: vfs_w  is vufsf = 3 & vufs != 0 & vfs_w { export vfs_w; }
Fsv:         is vufsf = 3 & vufs = 0 { export 0x3f800000:4; }
Ftv: vft_x  is vuftf = 0 & vuft != 0 & vft_x { export vft_x; }
Ftv:         is vuftf = 0 & vuft = 0 { export 0:4; }
Ftv: vft_y  is vuftf = 1 & vuft != 0 & vft_y { export vft_y; }
Ftv:         is vuftf = 1 & vuft = 0 { export 0:4; }
Ftv: vft_z  is vuftf = 2 & vuft != 0 & vft_z { export vft_z; }
Ftv:         is vuftf = 2 & vuft = 0 { export 0:4; }
Ftv: vft_w  is vuftf = 3 & vuft != 0 & vft_w { export vft_w; }
Ftv:         is vuftf = 3 & vuft = 0 { export 0x3f800000:4; }

# Integer registers: vi0 reads as 0 and ignores writes. Values are 16 bits in a 4-byte
# register, every write masks to 16 bits.
IRs: vuis  is vzs != 0 & vuis { export vuis; }
IRs:      is vzs = 0 { export 0:4; }
IRt: vuit  is vzt != 0 & vuit { export vuit; }
IRt:      is vzt = 0 { export 0:4; }
IWd: vuid  is vzd != 0 & vuid { export vuid; }
IWd:      is vzd = 0 { local t:4; export t; }
IWt: vuit  is vzt != 0 & vuit { export vuit; }
IWt:      is vzt = 0 { local t:4; export t; }
IWs: vuis  is vzs != 0 & vuis { export vuis; }
IWs:      is vzs = 0 { local t:4; export t; }

# COP2 control registers as the CFC2/CTC2 `fs` field names them: 0-15 VI, then Status,
# MAC, CLIP, -, R, I, Q, -, -, -, TPC, CMSAR0, FBRST, VPU-STAT, -, CMSAR1. A read is exact
# for the registers this language models (VI, CLIP, I, Q); Status, MAC, R and the
# VPU-controlled registers are changed by instructions or by the hardware without a
# model here, so reading them stays an opaque _cfc2 and the decompiler cannot fold a
# stale value into a branch. CcM is the width a write keeps (VI 16 bits, CLIP 24 bits).
CcR:       is vzs = 0 { export 0:4; }
CcR: vucc  is vzs >= 1 & vzs <= 15 & vucc { export vucc; }
CcR: vucc  is vzs = 18 & vucc { export vucc; }
CcR: vucc  is vzs = 21 & vucc { export vucc; }
CcR: vucc  is vzs = 22 & vucc { export vucc; }
CcR:       is vzs >= 16 & vzs != 18 & vzs != 21 & vzs != 22 & vzi { local t:4 = _cfc2(vzi:1); export t; }
CcW: vucc  is vzs != 0 & vucc { export vucc; }
CcW:       is vzs = 0 { local t:4; export t; }
CcM:       is vucc < 16 { export 0xffff:4; }
CcM:       is vucc = 18 { export 0xffffff:4; }
CcM:       is vucc > 15 & vucc != 18 { export 0xffffffff:4; }

