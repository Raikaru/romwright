# VU upper and macro-mode lower instructions (generated by gen_vu.py; do not edit).
# Per-lane float semantics, see vulanes.sinc. Not modelled: the MAC and status flag side
# effects of the arithmetic ops, the saturation of FTOI and of overflowing
# results to +-MAX, the VU's round-toward-zero, and the divide/sqrt exception flags.

define pcodeop _vrget;
define pcodeop _vrinit;
define pcodeop _vrnext;
define pcodeop _vrxor;

I: ""   is vuinterlock=0 { export 0:1; }
I: ".I" is vuinterlock=1 { export 0:1; }

dest: ""       is vudest=0b0000 { export 0b0000:4; }
dest: ".w"     is vudest=0b0001 { export 0b0001:4; }
dest: ".z"     is vudest=0b0010 { export 0b0010:4; }
dest: ".zw"    is vudest=0b0011 { export 0b0011:4; }
dest: ".y"     is vudest=0b0100 { export 0b0100:4; }
dest: ".yw"    is vudest=0b0101 { export 0b0101:4; }
dest: ".yz"    is vudest=0b0110 { export 0b0110:4; }
dest: ".yzw"   is vudest=0b0111 { export 0b0111:4; }
dest: ".x"     is vudest=0b1000 { export 0b1000:4; }
dest: ".xw"    is vudest=0b1001 { export 0b1001:4; }
dest: ".xz"    is vudest=0b1010 { export 0b1010:4; }
dest: ".xzw"   is vudest=0b1011 { export 0b1011:4; }
dest: ".xy"    is vudest=0b1100 { export 0b1100:4; }
dest: ".xyw"   is vudest=0b1101 { export 0b1101:4; }
dest: ".xyz"   is vudest=0b1110 { export 0b1110:4; }
dest: ".xyzw"  is vudest=0b1111 { export 0b1111:4; }

bc: "x" is vubc=0 { export 96:7; }
bc: "y" is vubc=1 { export 64:7; }
bc: "z" is vubc=2 { export 32:7; }
bc: "w" is vubc=3 { export 0:7; }

fsf: "x"     is vufsf=0 { export 0:1; }
fsf: "y"     is vufsf=1 { export 0:1; }
fsf: "z"     is vufsf=2 { export 0:1; }
fsf: "w"     is vufsf=3 { export 0:1; }

ftf: "x"     is vuftf=0 { export 0:1; }
