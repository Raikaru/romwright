# Build output
/build/
/dist/
/target/

# Java
*.class
*.jar
!third_party/**/*.jar
/.ghidra-java/

# Local analysis output
.romwright/
*.log
*.tmp
err

# Test artifacts
/test-out/
/test-projects/

# IDE and OS files
.vscode/
.idea/
*.user
*.suo
.DS_Store
Thumbs.db


# Native build outputs (regenerable: native/build_ghidra_opt.sh)
/native/build/
# Static language caches are regenerated from committed hash manifests.
/native/specs/x86-LE-32-default/
/native/specs/AARCH64-LE-64-v8A/
/native/specs/PowerPC-BE-32-default/
third_party/ghidra/decompiler/com_opt/
third_party/ghidra/decompiler/ghi_opt/
third_party/ghidra/decompiler/ghidra_opt
third_party/ghidra/decompiler/sla_opt/
third_party/ghidra/decompiler/sleigh_opt
/third_party/sysroots/
# Local analysis caches
.romwright/

# Volatile benchmark run artifacts (keep only the summarized report)
/benchmarks/reports/gate-run/
/benchmarks/reports/**/*.sqlite
# Hex-Rays comparator output: its EULA (2.1(v)) restricts publishing
# benchmark data, so these reports stay local (docs/console-research.md)
/benchmarks/reports/*hexrays*

# Python
__pycache__/
*.py[cod]
# Generated oracle caches: gates regenerate these per run, and committing
# them once swept a quarter of a million lines into a review.
/oracle/xrefs-v1/
/oracle/strings-v1/
/oracle/nonreturn-v1/
/oracle/switches-v1/

# Compiled SLEIGH artifacts (regenerate via native/languages/*/install.sh)
native/languages/**/*.sla
project.sqlite
*.sqlite-shm
*.sqlite-wal
# Xenon language: stock PowerPC sincs are symlinked in by install.sh at
# build time (absolute paths into the Ghidra install); only the xenon-local
# copies (ppc_common_vmx, altivec_xenon, vmx128) are committed.
native/languages/xenon/4xx.sinc
native/languages/xenon/FPRC.sinc
native/languages/xenon/SPEF_SCR.sinc
native/languages/xenon/SPE_APU.sinc
native/languages/xenon/SPE_EFSD.sinc
native/languages/xenon/SPE_EFV.sinc
native/languages/xenon/SPE_FloatMulAdd.sinc
native/languages/xenon/Scalar_SPFP.sinc
native/languages/xenon/altivec.sinc
native/languages/xenon/evx.sinc
native/languages/xenon/g2.sinc
native/languages/xenon/lmwInstructions.sinc
native/languages/xenon/lswInstructions.sinc
native/languages/xenon/mulhwInstructions.sinc
native/languages/xenon/ppc_a2.sinc
native/languages/xenon/ppc_common.sinc
native/languages/xenon/ppc_embedded.sinc
native/languages/xenon/ppc_instructions.sinc
native/languages/xenon/ppc_isa.sinc
native/languages/xenon/ppc_vle.sinc
native/languages/xenon/quicciii.sinc
native/languages/xenon/stmwInstructions.sinc
native/languages/xenon/stswiInstructions.sinc
native/languages/xenon/vsx.sinc
