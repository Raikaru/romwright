# Build output
/build/
/dist/
/target/

# Java
*.class
*.jar
!third_party/**/*.jar
/.ghidra-java/

# Local analysis output
.romwright/
*.log
*.tmp
err

# Test artifacts
/test-out/
/test-projects/

# IDE and OS files
.vscode/
.idea/
*.user
*.suo
.DS_Store
Thumbs.db


# Native build outputs (regenerable: native/build_ghidra_opt.sh)
/native/build/
# Static language caches are regenerated from committed hash manifests.
/native/specs/x86-LE-32-default/
/native/specs/AARCH64-LE-64-v8A/
/native/specs/PowerPC-BE-32-default/
third_party/ghidra/decompiler/com_opt/
third_party/ghidra/decompiler/ghi_opt/
third_party/ghidra/decompiler/ghidra_opt
third_party/ghidra/decompiler/sla_opt/
third_party/ghidra/decompiler/sleigh_opt
/third_party/sysroots/
# Local analysis caches
.romwright/

# Volatile benchmark run artifacts (keep only the summarized report)
/benchmarks/reports/gate-run/
/benchmarks/reports/**/*.sqlite
# Hex-Rays comparator output: its EULA (2.1(v)) restricts publishing
# benchmark data, so these reports stay local (docs/console-research.md)
/benchmarks/reports/*hexrays*

# Python
__pycache__/
*.py[cod]
# Generated oracle caches: gates regenerate these per run, and committing
# them once swept a quarter of a million lines into a review.
/oracle/xrefs-v1/
/oracle/strings-v1/
/oracle/nonreturn-v1/
/oracle/switches-v1/

# Compiled SLEIGH artifacts (regenerate via native/languages/*/install.sh)
native/languages/**/*.sla
project.sqlite
*.sqlite-shm
*.sqlite-wal
# Build artifact from the disasm harness.
third_party/ghidra/decompiler/libsla.a
third_party/ghidra/decompiler/com_opt/

# Portable release archives (packaging/stage_portable.py)
/dist-portable/
